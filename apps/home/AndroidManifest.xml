<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.yohannaftali.axshome"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Read-only network status for the top bar icon; there is no INTERNET permission. -->
    <!-- Screensaver settings live in AXS Clock (same signing key); AXS Home itself stays offline. -->
    <uses-permission android:name="io.github.yohannaftali.axsclock.permission.SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Own wallpaper files from USB drives and Download/Pictures/Movies (asked once). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- System monitor's "apps used today" list. apply.sh allows it with appops;
         without it the page shows the system-wide figures only. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Names and icons in that list also for apps without a launcher entry (e.g. screensavers). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- targetSdk 30 package visibility: needed to read other apps' banners and launch intents. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:label="AXS Home"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@style/Home">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
