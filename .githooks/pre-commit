#!/bin/sh
# Blocks a commit that contains .env, captures/, or any of the private values
# from .env (TV IP, Netflix ESN). The repo is public; this is the last gate.
# Enabled with: git config core.hooksPath .githooks
set -u
ROOT=$(git rev-parse --show-toplevel)
ENV_FILE="$ROOT/.env"
fail=0

if git diff --cached --name-only | grep -Eq '(^|/)\.env$|^captures/'; then
  echo "pre-commit: refusing to commit .env or captures/" >&2; fail=1
fi

if [ -f "$ENV_FILE" ]; then
  while IFS='=' read -r key val; do
    case "$key" in ''|\#*) continue ;; esac
    val=$(printf '%s' "$val" | tr -d '\r"'"'"' ')
    [ ${#val} -ge 6 ] || continue
    if git diff --cached -U0 --no-color | grep -qF -- "$val"; then
      echo "pre-commit: staged changes contain the value of '$key' from .env" >&2; fail=1
    fi
  done < "$ENV_FILE"
fi

if git diff --cached -U0 --no-color | grep -E '^\+' | grep -Eq '\bNF[A-Z0-9]{2,}[-_][A-Za-z0-9=_~.-]{8,}'; then
  echo "pre-commit: staged changes contain something that looks like a Netflix ESN" >&2; fail=1
fi

[ "$fail" -eq 0 ] || { echo "pre-commit: run output through scripts/redact.sh" >&2; exit 1; }
